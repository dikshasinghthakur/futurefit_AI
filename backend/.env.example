# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=futurefit

# --- Security (generate: python -c "import secrets; print(secrets.token_urlsafe(64))") ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_HOST=

# --- Optional bootstrap admin (created on first start if both are set) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional LLM enrichment (resume skill enrichment + coach notes). Leave blank to disable. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
